{
  "manifest_version": 2,
  "id": "github.brxym.feiyu-media",
  "name": "肥鱼会话媒体回复",
  "version": "1.4.4",
  "description": "向当前QQ私聊发送肥鱼语音、图片和表情，异步任务绑定原会话。",
  "author": {
    "name": "BRXYM",
    "url": "https://github.com/BRXYM"
  },
  "urls": {
    "repository": "https://github.com/BRXYM/maibot-feiyu-media"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.4.6",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_private_streams",
    "chat.open_session",
    "send.text",
    "api.call",
    "message.get_recent"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
